{
  "version": 2,
  "builds": [
    { "src": "app.py", "use": "@vercel/python" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/app.py" },
    { "src": "/health", "dest": "/app.py" },
    { "src": "/app", "dest": "/index.html" },
    { "src": "/recording", "dest": "/index.html" },
    { "src": "/extension", "dest": "/extension.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/app.py" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), geolocation=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=15552000; includeSubDomains" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
    ] }
  ]
}
