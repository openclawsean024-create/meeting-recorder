{
  "manifest_version": 3,
  "name": "MeetingFlow 會議錄製器",
  "version": "1.0.0",
  "description": "錄製 Google Meet、Zoom Web 與其他瀏覽器會議分頁音訊，會後匯入 MeetingFlow。",
  "permissions": ["tabCapture", "offscreen", "storage", "downloads"],
  "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeetingFlow 會議錄製器"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [{
    "resources": ["offscreen.html"],
    "matches": ["<all_urls>"]
  }]
}
