# Optional: enables server-side audio transcription. Never expose this in browser JavaScript.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Public cloud transcription is opt-in and rate-limited. Set true only when you accept provider cost/privacy implications.
PUBLIC_TRANSCRIBE_ENABLED=false
PUBLIC_TRANSCRIBE_LIMIT=3

# Optional comma-separated production origins. Empty disables CORS (same-origin only).
ALLOWED_ORIGINS=
